### 13. Удалить созданный фильм — 204
DELETE {{baseUrl}}/api/v1/movies/{{catalogMovieId}}

> {%
    client.test("Фильм удалён", function () {
        client.assert(response.status === 204, "Ожидается 204");
    });
%}

### 14. Изменить рейтинг уже удалённого фильма — 404
PATCH {{baseUrl}}/api/v1/movies/{{catalogMovieId}}/rating?rating=8

> {%
    client.test("Удалённый фильм не найден", function () {
        client.assert(response.status === 404, "Ожидается 404");
    });
%}
